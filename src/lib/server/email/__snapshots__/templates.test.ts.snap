// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`emails > confirmEmail has a plain-text part and an HTML part, each matching its snapshot > html 1`] = `
"<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width"><title>Confirm your new email for Acme</title></head>
<body style="margin:0;padding:0;background-color:#fcfcfc;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#fcfcfc;"><tr><td align="center" style="padding:24px 12px;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px;background-color:#ffffff;border:1px solid #e5e5e5;border-radius:12px;font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;color:#171717;">
<tr><td style="padding:24px 24px 8px;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0">
<tr><td style="padding:0 0 20px;font-size:14px;line-height:20px;font-weight:600;">Acme</td></tr>
<tr><td style="padding:0 0 16px;font-size:15px;line-height:22px;">Use this link to make ada.new@example.com your sign-in email for Acme.</td></tr>
<tr><td style="padding:0 0 16px;"><a href="https://campfire.test/login/confirm-email?token=t4" style="display:inline-block;padding:9px 16px;border-radius:8px;background-color:#262626;color:#fcfcfc;font-size:14px;font-weight:600;text-decoration:none;">Confirm email</a></td></tr>
<tr><td style="padding:0 0 16px;font-size:13px;line-height:18px;color:#737373;">The link works once and expires in 1 hour. If you didn’t ask for this, you can ignore this email; your sign-in email hasn’t changed.</td></tr>
</table>
</td></tr>
</table>
</td></tr></table>
</body>
</html>"
`;

exports[`emails > confirmEmail has a plain-text part and an HTML part, each matching its snapshot > text 1`] = `
"Acme

Use this link to make ada.new@example.com your sign-in email for Acme.

Confirm email: https://campfire.test/login/confirm-email?token=t4

The link works once and expires in 1 hour. If you didn’t ask for this, you can ignore this email; your sign-in email hasn’t changed."
`;

