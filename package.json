		"yjs": "^13.6.33",
		"yoga-wasm-web": "0.3.3"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"description": "Async discussions for one organization, self-hosted on Cloudflare",
	"suede": {
		"from": "2026.11.14.1",
		"versioning": "chronver"
	}
}
