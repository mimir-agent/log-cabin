		"@resvg/resvg-wasm": "^2.6.2",
		"@taurean/suede-css": "^0.13.0",
		"@tiptap/core": "^3.34.0",
		"@tiptap/extension-code-block": "^3.34.0",
		"@tiptap/extension-code-block-lowlight": "^3.34.0",
		"@tiptap/extension-collaboration": "^3.34.0",
		"@tiptap/extension-collaboration-caret": "^3.34.0",
		"@tiptap/extension-details": "^3.34.0",
		"@tiptap/extension-image": "^3.34.0",
		"@tiptap/extension-list": "^3.34.0",
		"@tiptap/extension-mention": "^3.34.0",
		"@tiptap/extension-typography": "^3.34.0",
		"@tiptap/extensions": "^3.34.0",
		"@tiptap/pm": "^3.34.0",
		"@tiptap/starter-kit": "^3.34.0",
		"@tiptap/suggestion": "^3.34.0",
		"@tiptap/y-tiptap": "^3.3.0",
		"bits-ui": "^2.20.2",
		"lib0": "^0.2.120",
		"lottie-web": "^5.13.0",
		"lowlight": "^3.3.0",
